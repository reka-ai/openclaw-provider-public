#!/bin/sh
set -eu

runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$runtime_dir")

# All state remains in this project unless explicitly overridden by the caller.
export OPENCLAW_STATE_DIR="${OPENCLAW_STATE_DIR:-$project_dir/state}"
export OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG_PATH:-$OPENCLAW_STATE_DIR/openclaw.json}"

# OpenClaw checks its own Node requirement and says which version it needs.
node_bin=$(command -v "${REKA_OPENCLAW_NODE:-node}" || true)
if [ -z "$node_bin" ]; then
  echo 'Node was not found. Install the Node version OpenClaw requires, or set REKA_OPENCLAW_NODE to its executable.' >&2
  exit 1
fi
# Prepend an absolute directory only; a bare "." would let the cwd shadow real tools.
case $node_bin in
  /*) ;;
  *) node_bin="$(pwd)/$node_bin" ;;
esac
export PATH="$(dirname -- "$node_bin"):$PATH"
exec "$node_bin" "$runtime_dir/node_modules/openclaw/openclaw.mjs" "$@"
